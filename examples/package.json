{
  "name": "examples",
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config=webpack.config.js",
    "clean:prod": "rm -rf build && rm -rf dist && mkdir dist",
    "copy:index": "cp ./dist/index.html ../index.html && cp ./dist/index.html ../404.html",
    "build:webpack": "cross-env NODE_ENV=production webpack --progress --config webpack.config.js",
    "build": "npm run clean:prod && npm run lint && npm run build:webpack && npm run copy:index",
    "git:commit": "cd .. && npm run git:commit",
    "git:push": "cd .. && npm run git:push",
    "git:commit:push": "cd .. && npm run git:commit:push",
    "git:merge:mirror": "cd .. && npm run git:merge:mirror",
    "reinstall": "npm run reinstall:module",
    "reinstall:module": "rm -rf node_modules && rm -f package-lock.json && npm i",
    "lint": "eslint src",
    "tsc": "npx tsc --noEmit",
    "pub": "cd .. && npm run pub"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@soda/friendly-errors-webpack-plugin": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.34",
    "browserslist-config-baseline": "^0.5.0",
    "classnames": "^2.5.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "path": "^0.12.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "styled-components": "^6.6.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
